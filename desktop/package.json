{
  "name": "jarvis-desktop",
  "version": "3.0.0",
  "description": "JARVIS desktop agent: local AI assistant and Windows computer control. Self-contained, no cloud, no API keys.",
  "main": "main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "headless": "node headless.js",
    "test": "node --test tests/*.test.js",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "local.jarvis.desktop",
    "productName": "JARVIS",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "headless.js", "src/**/*", "assets/**/*", "package.json"],
    "extraResources": [{ "from": "../client/dist", "to": "client-dist" }],
    "win": { "target": "nsis", "icon": "assets/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": { "target": "AppImage", "icon": "assets/icon.png" },
    "mac": { "target": "dmg", "icon": "assets/icon.png" }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
