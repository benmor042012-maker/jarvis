# Copy to .env (or export in your shell). The server reads these at startup.
# Never commit a real .env.

# OpenAI-compatible provider. Leave JARVIS_API_KEY empty to run in mock mode.
JARVIS_PROVIDER=openai-compatible
JARVIS_API_KEY=
JARVIS_MODEL=gpt-4o-mini
JARVIS_BASE_URL=https://api.openai.com/v1
# Examples for local models:
#   Ollama:    JARVIS_BASE_URL=http://localhost:11434/v1   JARVIS_MODEL=llama3.1   JARVIS_API_KEY=ollama
#   LM Studio: JARVIS_BASE_URL=http://localhost:1234/v1

# Directory the assistant may search, read and create text files in.
JARVIS_WORKSPACE_DIR=./workspace

# manual = confirm everything | ask = confirm medium/high (default) | auto = confirm high only
JARVIS_PERMISSION_MODE=ask

# Comma-separated hosts open_url may target (subdomains included).
JARVIS_ALLOWED_URL_HOSTS=google.com,youtube.com,github.com,wikipedia.org,stackoverflow.com,docs.python.org,developer.mozilla.org,localhost

# Force mock mode even if a key is present.
JARVIS_MOCK=false
